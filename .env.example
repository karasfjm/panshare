# ===== 115 账号 =====
# 二选一：直接给 cookies 字符串，或用文件（推荐，文件放在 /config 下）
# 两者都可以不填：服务照常启动，起来后在网页「115 助手」里粘贴 cookies 即可
# P115_COOKIES=UID=xxx; CID=xxx; SEID=xxx; KID=xxx
P115_COOKIE_FILE=/config/115-cookies.txt

# ===== 扫描范围 =====
# 初始监控目录（115 目录 id），多个用逗号分隔。留空 = 先不生成任何 strm，
# 打开网页在「目录管理」里添加要同步的目录即可（推荐）。
# 只在首次启动时写入数据库作为初始列表；之后以网页管理为准，改这里不再生效。
ROOT_CIDS=
# 非 0 根目录时，是否把该目录名作为本地一级目录
INCLUDE_ROOT_NAME=1
# 只生成这些后缀（留空用默认视频后缀），或 STRM_ALL_FILES=1 全都要
# STRM_EXT=.mp4,.mkv,.ts,.iso
STRM_ALL_FILES=0
# 额外的包含 / 排除规则（正则，作用于文件名）
# INCLUDE_REGEX=
# EXCLUDE_REGEX=
# 跳过这些目录（大小写不敏感的子串匹配）
# EXCLUDE_DIRS=#recycle,临时

# ===== 输出 =====
STRM_ROOT=/strm

# ===== 全量扫描 =====
# 115 的接口前面有一层阿里云 WAF：请求太快会按账号返回 405 拦截页
# （不是接口下线——不带 cookies 请求同一接口是正常的）。所以默认很保守：
# 2 QPS、单个目录串行。被拦时程序会先换入口再退避，不会把账号打爆。
SCAN_APP=web
# 全局请求上限（次/秒），所有 115 请求共用。被 405 拦过就降到 1
API_QPS=2
SCAN_WORKERS=2
# 单个目录内并发翻页数，0 = 串行（推荐，配合 API_QPS 已足够）
PAGE_WORKERS=0
# 额外的每次请求冷却（秒）；限速已由 API_QPS 负责，一般不用碰
SCAN_COOLDOWN=0
# auto：首次启动或索引为空时全量；always：每次启动全量；never：不自动全量
FULL_SCAN_ON_START=auto
# 全量后删除 115 上已不存在的 .strm（STRM_ROOT 必须是专用目录）
DELETE_ORPHAN=1
DELETE_EMPTY_DIRS=1

# ===== 增量 =====
# 优先用 115「生活事件」实时同步；事件接口不可用（被限流、探测失败）时，
# 自动降级成「每隔 FALLBACK_INTERVAL 秒做一次指纹增量扫描」：
# 只重列 mtime 变化过的目录，通常几秒就跑完。
EVENT_ENABLED=1
EVENT_APP=web
EVENT_INTERVAL=30
EVENT_COOLDOWN=0.6
EVENT_BATCH=1000
# 事件不可用时的补扫间隔（秒）
FALLBACK_INTERVAL=600
# 增量扫描按目录 mtime 跳过没变化的子树（建议保持 1）
SMART_SCAN=1
# 每隔多少小时做一次全量对账（0 = 关闭）。指纹跳过依赖 115 更新目录 mtime，
# 想更保险可以设成 24，定期把整棵树重列一遍
RECONCILE_HOURS=0

# ===== ed2k：链接 → strm（默认播放时才转存）=====
# 粘贴 ed2k 链接后立刻生成 strm；默认等播放到该片时才以「离线下载」方式转存到下面的目录
# （ED2K_AUTO_TRANSFER=1 可改回「添加时就转存」）。播放时文件若已被清理，会自动重新转存。
ED2K_ENABLED=1
# 115 上的转存目录 id。留 0 = 首次使用时自动在网盘根目录创建 ED2K_DIR_NAME。
# 也可以启动后在网页「ed2k 转存播放」里填目录 id / 粘 115 目录链接来改（即时生效）
ED2K_DIR_CID=0
ED2K_DIR_NAME=p115-strm-ed2k
# strm 输出子目录（相对 STRM_ROOT）
ED2K_STRM_DIR=ed2k
# 转存文件保留多少小时（从最后一次播放算；0 = 不自动清理）
ED2K_TTL_HOURS=24
# 每隔多少秒检查一次是否需要清理
ED2K_CLEAN_INTERVAL=600
# 转存中的任务多久刷新一次状态
ED2K_POLL_INTERVAL=20
# 播放时最多等多少秒让文件转存到位（首次转存可能要等）
ED2K_PLAY_WAIT=45
# 添加后立刻提交离线转存？
#   0（默认）= 只写 strm，播放到该片时才转存（不看的片子不占网盘空间）
#   1        = 添加时就转存到 115（老行为，首次播放不用等）
# 网页「工具 → ed2k STRM」里的「添加后立即转存」开关会覆盖这个值（存数据库，改完即时生效）
ED2K_AUTO_TRANSFER=0

# ===== 115 分享转存 =====
# 粘贴分享链接 → 转存到接收目录 → 生成 strm（转存后文件是自己的，永久可播）
SHARE_ENABLED=1
# 接收目录 id，0 = 首次使用时自动在网盘根目录创建 SHARE_DIR_NAME
SHARE_DIR_CID=0
SHARE_DIR_NAME=p115-strm-share
# strm 输出子目录（相对 STRM_ROOT）
SHARE_STRM_DIR=share

# ===== Emby 302 反代 =====
# 开启后本服务会把请求转发给上游 Emby，并把 PlaybackInfo 里的
# MediaSource 改写成 302 直链。
# 独立端口（EMBY_PROXY_PORT > 0）：客户端服务器地址填 http://本机:<端口>，
#   **不用加任何路径前缀**；记得在 docker-compose 的 ports 里映射同一端口。
# 独立端口为 0：客户端地址填 http://本机:9527/emby。
# 端口也可以直接在网页「媒体与反代 → Emby 反代」里改，保存后立即生效
#（不用重启容器），但改完要同步改 compose 的 ports 映射。
EMBY_ENABLED=0
# 上游 Emby 地址
EMBY_URL=
# strm 在 Emby 容器里的挂载路径前缀（与 STRM_ROOT 一致时可留空自动识别）
# 注意：这是用来识别哪些文件是本服务生成的 strm，不是客户端地址的前缀
EMBY_STRM_PREFIX=
# 自定义路径替换规则，每行一条，格式：正则=>模板
# 模板里可用 $1..$9（捕获组）和 {base}（本服务地址）；dbpath: 开头表示
# 按 115 相对路径在本地索引里找文件。例如把 123 网盘的 strm 映射到 115 索引：
#   ^/mnt/123媒体库/(.*)$=>dbpath:$1
EMBY_PATH_RULES=
# 反代独立端口（0 = 关闭，改用本服务端口的 /emby）
EMBY_PROXY_PORT=0

# ===== 多账号监控（v1.6.0） =====
# 子账号不用环境变量：网页「115 多账号」卡片添加（账号名 + cookies），
# 每个账号独立扫描生成 strm 到 STRM_ROOT/<账号名>/，播放用各自账号的直链。
# 登记保存在 DATA_DIR/accounts.json，重启自动恢复。

# ===== 秒传播放（多账号） =====
# 秒传账号在网页「秒传 & Emby 302 反代」卡片里添加（存数据库，不用环境变量）；
# 可按 Emby 用户分配不同账号。暂存目录建在目标账号网盘根目录。
INSTANT_DIR_NAME=p115-strm-instant
# 秒传直链缓存时长（秒），同播的多个用户复用同一次秒传结果
INSTANT_CACHE_SECONDS=1800
# 校验缓存（115 二次校验要的那段字节）的字节上限（MB）。
# 这一层缓存的是文件内容，按内容算大小、只增不减，所以要设上限：
# 超出后服务会定期丢掉最久没用的那些（丢掉的只是「省一次源盘读取」，
# 下次播放重新读一次就好，不会影响能播的文件）。0 = 不限制。
INSTANT_DIGEST_MAX_MB=512
# 每隔多少秒检查一次缓存是否超限
INSTANT_DIGEST_CLEAN_INTERVAL=3600
# 后台清理线程的检查间隔
INSTANT_DIGEST_POLL_INTERVAL=300

# ===== HTTP =====
WEB_ENABLED=1
WEB_HOST=0.0.0.0
WEB_PORT=9527
# ===== 网页登录（账号密码由这里生成） =====
# 打开网页先登录；UI_PASSWORD 留空 = 不启用登录（内网自用可关）
UI_USERNAME=admin
UI_PASSWORD=p115strm
# 站点名（显示在登录页与标题栏）
UI_SITE_NAME=p115-strm
# 登录页是否提示默认账号（1/0）
UI_SHOW_HINT=1
# 会话有效期（秒，默认 7 天）
UI_SESSION_TTL=604800
# strm 里写入的地址前缀，必须是 Emby/Jellyfin 能访问到的地址
PUBLIC_BASE_URL=http://192.168.1.10:9527
# 302：播放器直接连 115（推荐）；proxy：由本容器中转（115 风控严格时用）
PLAY_MODE=302
# 自定义播放地址模板，可用 {base} {pickcode} {name} {ext} {token}
# PLAY_URL_TEMPLATE=http://alist.local:5244/d/115/{pickcode}
PLAY_URL_EXT=1
PLAY_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36
PLAY_CACHE_SECONDS=900
# 访问令牌，设置后 strm 地址会带 ?token=xxx（开启后旧 strm 需重新生成）
# AUTH_TOKEN=

# ===== 登录页背景（TMDB 热门剧照） =====
# v3 API Key 或 v4 Read Access Token，二选一；都不填则登录页用渐变背景
# TMDB_API_KEY=
# TMDB_READ_TOKEN=
# 国内网络 / 容器内直连 api.themoviedb.org 会 SSL 握手超时，填宿主机的代理地址
# （只作用于 TMDB 的片单和图片请求，115 接口不走它）
# TMDB_PROXY=http://192.168.1.10:7890
# 不想用 TMDB 时可以直接给图片直链，逗号分隔
# LOGIN_BACKDROPS=

# ===== 其它 =====
MODE=all
LOG_LEVEL=INFO
# 命名时区；基础镜像若没带 tzdata，入口脚本会自动退回 CST-8（同为 UTC+8）
TZ=Asia/Shanghai
# NAS 上用于修正 /config、/strm 的属主（填数字 uid/gid，不需要系统里有同名用户）
# PUID=1000
# PGID=1000
# 改 1 才会递归改 /strm 里已有文件的属主（文件多时启动会变慢）
# CHOWN_RECURSIVE=0
